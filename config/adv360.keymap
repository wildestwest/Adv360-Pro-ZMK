#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&caps_word {
    continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO


        #endif

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <8 9 10 11 12 13 22 23 24 25 26 27 40 41 42 43 44 45 54 55 56 57 58 71 72 73 74 59 75 7 21 39 37 38 53 68 69 70 71>;
            hold-trigger-on-release;
            require-prior-idle-ms = <100>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 14 15 16 17 18 19 28 29 30 31 32 33 47 48 49 50 51 61 62 63 64 6 20 34 46 60 35 36 52 65 66 67>;
            hold-trigger-on-release;
            require-prior-idle-ms = <100>;
        };

        layer_tap_cursor: layer_tap_cursor {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_CURSOR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <70 69 41 23 42 24 68 40 54>;
        };

        layer_tap_symbol: layer_tap_symbol {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SYMBOL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67 22 40 54 41 42 43 44>;
        };

        layer_tap_num: layer_tap_num {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_NUM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <22 23 24 25 26 40 41 42 43 44 54 55 56 57 58 69 70 68 59 45 27>;
        };

        layer_tap_wksp: layer_tap_wksp {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_WKSP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <15 29 30 16 17 31 32 18 19 33 22 40 41 23 24 42 25 43 26 44 51>;
        };

        sticky_shift: sticky_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_SHIFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        voldown_pp_mute: voldown_pp_mute {
            compatible = "zmk,behavior-tap-dance";
            label = "VOLDOWN_PP_MUTE";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_DOWN>, <&kp C_PLAY_PAUSE>, <&kp C_MUTE>;
        };

        volup_next: volup_next {
            compatible = "zmk,behavior-tap-dance";
            label = "VOLUP_NEXT";
            #binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp C_NEXT>;
        };

        shift_caps_word: shift_caps_word {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPS_WORD";
            #binding-cells = <0>;
            bindings = <&sticky_shift LEFT_SHIFT>, <&caps_word>;
        };
    };

    combos {
        compatible = "zmk,combos";

        capsword {
            bindings = <&caps_word>;
            key-positions = <65 70>;
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };
    };

    macros {
        email: email {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp U &kp B &kp S &kp AT &kp B &kp U &kp B &kp S &kp DOT &kp P &kp R &kp O>;
            label = "EMAIL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        enthium {
            bindings = <
&to 5            &kp N1            &kp N2                &kp N3                 &kp N4             &kp N5     &email                                                                                                              &out OUT_TOG           &kp N6  &kp N7              &kp N8        &kp N9           &kp N0         &to 7
&kp HOME         &kp Z             &kp Y                 &kp O                  &kp U              &kp SEMI   &bt BT_SEL 0                                                                                                        &bt BT_SEL 1           &kp X   &kp L               &kp D         &kp W            &kp V          &kp END
&kp B            &hml LGUI C       &hml LEFT_ALT I       &hml LCTRL E           &hml LEFT_SHIFT A  &kp COMMA  &bt BT_SEL 2               &kp K_COPY               &kp K_PASTE      &voldown_pp_mute  &volup_next                  &bt BT_SEL 3           &kp K   &hmr RIGHT_SHIFT H  &hmr RCTRL T  &hmr LEFT_ALT S  &hmr RGUI N    &kp Q
&kp EXCLAMATION  &kp SINGLE_QUOTE  &kp MINUS             &kp EQUAL              &kp PERIOD         &kp SLASH                                                      &caps_word       &kp DELETE                                                            &kp J   &kp M               &kp G         &kp P            &kp F          &kp BACKSLASH
&mo 1            &kp GRAVE         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &shift_caps_word              &layer_tap_cursor 2 SPACE  &layer_tap_num 3 ESCAPE  &kp TAB          &kp ENTER         &layer_tap_wksp 4 BACKSPACE  &layer_tap_symbol 6 R          &shift_caps_word    &kp LBKT      &kp RBKT         &kp BACKSLASH  &mo 1
            >;
        };

        sys {
            bindings = <
&to 5        &to 0         &kp F2        &kp F3        &kp F4        &kp F5  &trans                                                &trans           &kp F6  &kp F7      &kp F8             &kp F9        &to 0                        &to 5
&to 7        &trans        &trans        &trans        &trans        &trans  &trans                                                &trans           &trans  &trans      &trans             &trans        &trans                       &to 7
&none        &trans        &trans        &trans        &trans        &trans  &trans  &trans        &trans      &trans  &trans      &trans           &trans  &trans      &trans             &trans        &trans                       &bt BT_CLR
&bootloader  &trans        &trans        &trans        &trans        &trans                        &trans      &trans                               &trans  &trans      &trans             &trans        &mt LS(BACKSLASH) BACKSLASH  &bootloader
&bootloader  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &trans  &bt BT_SEL 0  &trans      &none   &bl BL_TOG  &rgb_ug RGB_TOG          &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp C_NEXT                   &bootloader
            >;
        };

        cursor {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                              &none  &none           &none            &none     &none  &none  &none
&none  &none  &none  &none  &none  &none  &none                                              &none  &none           &kp RIGHT_ARROW  &kp END   &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none      &none          &none  &kp UP_ARROW    &kp LEFT_ARROW   &kp HOME  &none  &none  &none
&none  &none  &none  &none  &none  &none                &none      &none                            &kp DOWN_ARROW  &none            &none     &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none      &kp ENTER  &kp BACKSPACE  &none                  &none            &none     &none  &none  &none
            >;
        };

        num {
            bindings = <
&none  &none          &none    &none      &none      &none  &none                                               &none   &none  &none         &none   &none   &none        &none
&none  &none          &none    &none      &none      &none  &none                                               &none   &kp K  &kp N7        &kp N8  &kp N9  &kp PERCENT  &kp COLON
&none  &kp BACKSPACE  &kp TAB  &kp SPACE  &kp ENTER  &none  &none  &none  &none      &none          &none       &none   &kp G  &kp NUMBER_4  &kp N5  &kp N6  &kp MINUS    &kp PLUS
&none  &none          &none    &none      &none      &none                &none      &none                              &kp J  &kp N1        &kp N2  &kp N3  &kp FSLH     &kp ASTERISK
&none  &none          &none    &none      &none             &none  &none  &none      &kp BACKSPACE  &kp PERIOD  &kp N0         &none         &none   &none   &none        &none
            >;
        };

        workspaces {
            bindings = <
&none  &none           &none           &none           &none           &none           &none                                  &none  &none           &none           &none           &none           &none           &none
&none  &kp LS(LG(N1))  &kp LS(LG(N2))  &kp LS(LG(N3))  &kp LS(LG(N4))  &kp LG(LS(N5))  &none                                  &none  &kp LS(LG(N6))  &kp LS(LG(N7))  &kp LS(LG(N8))  &kp LS(LG(N9))  &kp LS(LG(N0))  &none
&none  &kp LG(N1)      &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)      &none  &none  &none      &none  &none  &none  &kp LG(N6)      &kp LG(N7)      &kp LG(N8)      &kp LG(N9)      &kp LG(N0)      &none
&none  &none           &none           &none           &none           &none                         &none      &none                &none           &none           &none           &none           &none           &none
&none  &none           &none           &none           &none                           &none  &none  &none      &none  &none  &none                  &none           &none           &none           &none           &none
            >;
        };

        gaming {
            bindings = <
&to 0  &kp NUMBER_6  &kp NUMBER_7  &kp N8  &kp N9  &kp N0  &none                                             &none  &none  &none  &none  &none  &none  &to 0
&kp U  &kp N1        &kp N2        &kp N3  &kp N4  &kp N5  &kp B                                             &none  &none  &none  &none  &none  &none  &none
&kp Y  &kp J         &kp Q         &kp W   &kp E   &kp R   &kp T      &kp TAB   &kp ENTER      &to 0  &to 0  &none  &none  &none  &none  &none  &none  &none
&kp G  &kp LSHFT     &kp A         &kp S   &kp D   &kp F                        &kp I          &none                &none  &none  &none  &none  &none  &none
&mo 1  &kp LCTRL     &kp Z         &kp X   &kp C           &kp SPACE  &kp LALT  &kp ESC        &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };

        symbol_v2 {
            bindings = <
&kp GRAVE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp PERIOD    &none                                                     &none  &none              &none          &none    &none      &none      &none
&kp EXCL   &kp COMMA         &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SEMI           &kp QUESTION  &none                                                     &none  &kp GRAVE          &none          &none    &none      &none      &none
&kp POUND  &kp CARET         &kp EQUAL             &kp UNDERSCORE         &kp DOLLAR         &kp ASTRK     &none        &kp BACKSLASH  &kp PERIOD      &none  &none  &none  &kp DOUBLE_QUOTES  &kp BACKSPACE  &kp TAB  &kp SPACE  &kp ENTER  &none
&kp TILDE  &kp LESS_THAN     &kp PIPE              &kp MINUS              &kp GREATER_THAN   &kp SLASH                                 &kp ASTRK       &none                &kp SINGLE_QUOTE   &none          &none    &none      &none      &none
&none      &kp AMPS          &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp PLUS                         &kp PERCENT  &kp COLON      &kp AT          &none  &none  &none                     &none          &none    &none      &none      &none
            >;
        };

        type {
            bindings = <
&to 0            &kp N1            &kp N2                &kp N3                 &kp N4            &kp N5     &email                                                                      &out OUT_TOG  &kp N6  &kp N7            &kp N8    &kp N9    &kp N0         &none
&kp HOME         &kp Z             &kp Y                 &kp O                  &kp U             &kp SEMI   &bt BT_SEL 0                                                                &bt BT_SEL 1  &kp X   &kp L             &kp D     &kp W     &kp V          &kp END
&kp B            &kp C             &kp I                 &kp E                  &kp A             &kp COMMA  &bt BT_SEL 2  &kp K_COPY  &kp K_PASTE      &voldown_pp_mute  &volup_next    &bt BT_SEL 3  &kp K   &kp H             &kp T     &kp S     &kp N          &kp Q
&kp EXCLAMATION  &kp SINGLE_QUOTE  &kp MINUS             &kp EQUAL              &kp PERIOD        &kp SLASH                            &caps_word       &kp DELETE                                     &kp J   &kp M             &kp G     &kp P     &kp F          &kp BACKSLASH
&mo 1            &kp GRAVE         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &shift_caps_word             &kp SPACE     &kp ESC     &kp TAB          &kp ENTER         &kp BACKSPACE  &kp R                 &shift_caps_word  &kp LBKT  &kp RBKT  &kp BACKSLASH  &mo 1
            >;
        };
    };
};
