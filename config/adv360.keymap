#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO


        #endif

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <8 9 10 11 12 13 22 23 24 25 26 27 40 41 42 43 44 45 54 55 56 57 58 71 72 73 74 59 75 7 21 39 37 38 53 68 69 70 71>;
            hold-trigger-on-release;
            require-prior-idle-ms = <100>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 14 15 16 17 18 19 28 29 30 31 32 33 47 48 49 50 51 61 62 63 64 6 20 34 46 60 35 36 52 65 66 67>;
            hold-trigger-on-release;
            require-prior-idle-ms = <100>;
        };

        layer_tap_cursor: layer_tap_cursor {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_CURSOR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <70 69 41 23 50 49 31 32 42 24>;
        };

        layer_tap_symbol: layer_tap_symbol {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SYMBOL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <15 16 17 18 32 31 30 29 47 48 49 50 23 41 55 56 42 24 25 43 57 58 44 26 65 66 67>;
        };

        layer_tap_num: layer_tap_num {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_NUM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <22 23 24 25 26 40 41 42 43 44 54 55 56 57 58 69 70 68 59 45 27>;
        };

        layer_tap_wksp: layer_tap_wksp {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_WKSP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <15 29 30 16 17 31 32 18 19 33 22 40 41 23 24 42 25 43 26 44 51>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&to 6           &kp N1       &kp N2           &kp N3        &kp N4             &kp N5     &to 7                                                                                                                &kp C_VOLUME_UP            &kp N6      &kp N7                &kp N8        &kp N9           &kp N0                 &to 6
&kp Q           &kp B        &kp Y            &kp O         &kp U              &kp SQT    &kp LG(C)                                                                                                            &kp C_VOLUME_DOWN          &kp SEMI    &kp L                 &kp D         &kp W            &kp V                  &kp Z
&kp LEFT_SHIFT  &hml LGUI C  &hml LEFT_ALT I  &hml LCTRL E  &hml LEFT_SHIFT A  &kp COMMA  &kp LG(V)                      &bt BT_NXT               &out OUT_TOG      &kp C_PLAY_PAUSE  &kp C_NEXT               &kp C_MUTE                 &kp PERIOD  &hmr RIGHT_SHIFT H    &hmr RCTRL T  &hmr LEFT_ALT S  &hmr RGUI N            &kp RIGHT_SHIFT
&caps_word      &kp G        &kp X            &kp J         &kp K              &kp MINUS                                                          &kp LCTRL         &kp LEFT_ALT                                                          &kp FSLH    &kp R                 &kp M         &kp F            &kp P                  &kp GRAVE
&mo 1           &kp HOME     &kp PG_UP        &kp PG_DN     &kp END                       &layer_tap_cursor 3 BACKSPACE  &layer_tap_num 4 ESCAPE  &kp DELETE        &kp TAB           &layer_tap_wksp 5 ENTER  &layer_tap_symbol 2 SPACE              &kp LEFT_PARENTHESIS  &kp LBKT      &kp RBKT         &kp RIGHT_PARENTHESIS  &mo 1
            >;
        };

        sys {
            bindings = <
&trans       &kp F1        &kp F2        &kp F3        &kp F4        &kp F5  &trans                                                &trans           &kp F6  &kp F7      &kp F8             &kp F9        &kp F10                      &trans
&trans       &trans        &trans        &trans        &trans        &trans  &trans                                                &trans           &trans  &trans      &trans             &trans        &trans                       &trans
&none        &trans        &trans        &trans        &trans        &trans  &trans  &trans        &trans      &trans  &trans      &trans           &trans  &trans      &trans             &trans        &trans                       &bt BT_CLR
&bootloader  &trans        &trans        &trans        &trans        &trans                        &trans      &trans                               &trans  &trans      &trans             &trans        &mt LS(BACKSLASH) BACKSLASH  &bootloader
&bootloader  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &trans  &bt BT_SEL 0  &trans      &tog 1  &bl BL_TOG  &rgb_ug RGB_TOG          &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp C_NEXT                   &bootloader
            >;
        };

        symbol {
            bindings = <
&none  &none            &none          &none      &none       &none   &none                                                  &none  &none      &none              &none                 &none                  &none              &none
&none  &kp PERCENT      &kp PIPE       &kp TILDE  &kp AMPS    &none   &none                                                  &none  &none      &kp SINGLE_QUOTE   &kp LESS_THAN         &kp GREATER_THAN       &none              &none
&none  &kp EXCLAMATION  &kp ASTERISK   &kp PLUS   &kp EQUAL   &kp AT  &none          &none      &none          &none  &none  &none  &kp LG(C)  &kp LEFT_BRACKET   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &none
&none  &kp CARET        &kp BACKSLASH  &kp POUND  &kp DOLLAR  &none                             &none          &none                &kp LG(V)  &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp GRAVE          &none
&none  &none            &none          &none      &none               &kp BACKSPACE  &kp SPACE  &kp ENTER      &none  &none  &none             &none              &none                 &none                  &none              &none
            >;
        };

        cursor {
            bindings = <
&none  &none  &none  &none          &none        &none  &none                                          &none           &none  &none            &none     &none  &none  &none
&none  &none  &none  &none          &none        &none  &none                                          &none           &none  &kp RIGHT_ARROW  &kp END   &none  &none  &none
&none  &none  &none  &kp PAGE_DOWN  &kp PAGE_UP  &none  &none  &none  &none      &none  &none          &none           &none  &kp LEFT_ARROW   &kp HOME  &none  &none  &none
&none  &none  &none  &kp DOWN       &kp UP       &none                &none      &none                                 &none  &none            &none     &none  &none  &none
&none  &none  &none  &none          &none               &none  &none  &none      &none  &kp BACKSPACE  &kp LEFT_SHIFT         &none            &none     &none  &none  &none
            >;
        };

        num {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                               &none   &none  &none         &none   &none   &none        &none
&none  &none  &none  &none  &none  &none  &none                                               &none   &kp K  &kp N7        &kp N8  &kp N9  &kp PERCENT  &kp COLON
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none          &none       &none   &kp G  &kp NUMBER_4  &kp N5  &kp N6  &kp MINUS    &kp PLUS
&none  &none  &none  &none  &none  &none                &none      &none                              &kp J  &kp N1        &kp N2  &kp N3  &kp FSLH     &kp ASTERISK
&none  &none  &none  &none  &none         &none  &none  &none      &kp BACKSPACE  &kp PERIOD  &kp N0         &none         &none   &none   &none        &none
            >;
        };

        workspaces {
            bindings = <
&trans  &trans          &trans          &trans          &trans          &trans          &trans                                      &trans  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &kp LS(LG(N1))  &kp LS(LG(N2))  &kp LS(LG(N3))  &kp LS(LG(N4))  &kp LG(LS(N5))  &trans                                      &trans  &kp LS(LG(N6))  &kp LS(LG(N7))  &kp LS(LG(N8))  &kp LS(LG(N9))  &kp LS(LG(N0))  &trans
&trans  &kp LG(N1)      &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)      &trans  &trans  &trans      &trans  &trans  &trans  &kp LG(N6)      &kp LG(N7)      &kp LG(N8)      &kp LG(N9)      &kp LG(N0)      &trans
&trans  &trans          &trans          &trans          &trans          &kp LG(Q)                       &trans      &trans                  &trans          &trans          &trans          &trans          &trans          &trans
&trans  &trans          &trans          &trans          &trans                          &trans  &trans  &trans      &trans  &trans  &trans                  &trans          &trans          &trans          &trans          &trans
            >;
        };

        gaming {
            bindings = <
&to 0   &none      &none   &none   &none   &none   &none                                             &none  &none  &none  &none  &none  &none  &none
&kp N0  &kp N1     &kp N2  &kp N3  &kp N4  &kp N5  &kp N6                                            &none  &none  &none  &none  &none  &none  &none
&kp Y   &kp J      &kp Q   &kp W   &kp E   &kp R   &kp T      &kp TAB   &kp ENTER      &none  &none  &none  &none  &none  &none  &none  &none  &none
&kp G   &kp LSHFT  &kp A   &kp S   &kp D   &kp F                        &kp I          &none                &none  &none  &none  &none  &none  &none
&kp V   &kp LCTRL  &kp Z   &kp X   &kp C           &kp SPACE  &kp LALT  &kp ESC        &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };

        typing {
            bindings = <
&to 6           &kp N1    &kp N2     &kp N3     &kp N4   &kp N5     &to 0                                                                                                                &kp C_VOLUME_UP            &kp N6      &kp N7                &kp N8    &kp N9    &kp N0                 &to 6
&kp Q           &kp B     &kp Y      &kp O      &kp U    &kp SQT    &kp LG(C)                                                                                                            &kp C_VOLUME_DOWN          &kp SEMI    &kp L                 &kp D     &kp W     &kp V                  &kp Z
&kp LEFT_SHIFT  &kp C     &kp I      &kp E      &kp A    &kp COMMA  &kp LG(V)                      &bt BT_NXT               &out OUT_TOG      &kp C_PLAY_PAUSE  &kp C_NEXT               &kp C_MUTE                 &kp PERIOD  &kp H                 &kp T     &kp S     &kp N                  &kp RIGHT_SHIFT
&caps_word      &kp G     &kp X      &kp J      &kp K    &kp MINUS                                                          &kp LCTRL         &kp LEFT_ALT                                                          &kp FSLH    &kp R                 &kp M     &kp F     &kp P                  &kp GRAVE
&mo 1           &kp HOME  &kp PG_UP  &kp PG_DN  &kp END             &layer_tap_cursor 3 BACKSPACE  &layer_tap_num 4 ESCAPE  &kp DELETE        &kp TAB           &layer_tap_wksp 5 ENTER  &layer_tap_symbol 2 SPACE              &kp LEFT_PARENTHESIS  &kp LBKT  &kp RBKT  &kp RIGHT_PARENTHESIS  &mo 1
            >;
        };
    };
};
