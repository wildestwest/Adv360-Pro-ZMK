#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <8 9 10 11 12 13 22 23 24 25 26 27 40 41 42 43 44 45 54 55 56 57 58 71 72 73 74 59 75 7 21 39 37 38 53 68 69 70 71>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 14 15 16 17 18 19 28 29 30 31 32 33 47 48 49 50 51 61 62 63 64 6 20 34 46 60 35 36 52 65 66 67>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        layer_tap_cursor: layer_tap_cursor {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_CURSOR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <39 40 41 42 43 44 45 70 69>;
        };

        layer_tap_symbol: layer_tap_symbol {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_SYMBOL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };

        layer_tap_num: layer_tap_num {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_NUM";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <8 9 10 11 12 22 23 24 25 26 40 41 42 43 44 54 55 56 57 58 71 72 73 74 69 70 68>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        Sleep {
            bindings = <&kp LG(LA(C_SLEEP))>;
            key-positions = <0 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL       &kp N1       &kp N2           &kp N3        &kp N4             &kp N5     &kp PRINTSCREEN                                                                                         &kp C_VOLUME_UP            &kp N6      &kp N7              &kp N8        &kp N9           &kp N0        &kp BSLH
&kp Q           &kp B        &kp Y            &kp O         &kp U              &kp SQT    &mt LS(LC(C)) LC(C)                                                                                     &kp C_VOLUME_DOWN          &kp SEMI    &kp L               &kp D         &kp W            &kp V         &kp Z
&kp LEFT_SHIFT  &hml LGUI C  &hml LEFT_ALT I  &hml LCTRL E  &hml LEFT_SHIFT A  &kp COMMA  &mt LS(LC(V)) LC(V)            &bt BT_NXT               &out OUT_TOG      &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE                 &kp PERIOD  &hmr RIGHT_SHIFT H  &hmr RCTRL T  &hmr LEFT_ALT S  &hmr RGUI N   &kp RIGHT_SHIFT
&caps_word      &kp G        &kp X            &kp J         &kp K              &kp MINUS                                                          &kp HOME          &kp END                                                  &kp FSLH    &kp R               &kp M         &kp F            &kp P         &to 5
&mo 1           &kp HOME     &kp PG_UP        &kp PG_DN     &kp END                       &layer_tap_cursor 3 BACKSPACE  &layer_tap_num 4 DELETE  &kp ESC           &kp TAB           &kp RET     &layer_tap_symbol 2 SPACE              &kp LS(LPAR)        &kp LBKT      &kp RBKT         &kp LS(RPAR)  &mo 1
            >;
        };

        sys {
            bindings = <
&trans       &kp F1        &kp F2        &kp F3        &kp F4        &kp F5  &trans                                                &trans           &kp F6  &kp F7      &kp F8             &kp F9        &kp F10                      &trans
&trans       &trans        &trans        &trans        &trans        &trans  &trans                                                &trans           &trans  &trans      &trans             &trans        &trans                       &trans
&trans       &trans        &trans        &trans        &trans        &trans  &trans  &trans        &trans      &trans  &trans      &trans           &trans  &trans      &trans             &trans        &trans                       &bt BT_CLR
&bootloader  &trans        &trans        &trans        &trans        &trans                        &trans      &trans                               &trans  &trans      &trans             &trans        &mt LS(BACKSLASH) BACKSLASH  &bootloader
&bootloader  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &trans  &bt BT_SEL 0  &trans      &tog 1  &bl BL_TOG  &rgb_ug RGB_TOG          &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOL_UP  &kp C_NEXT                   &bootloader
            >;
        };

        symbol {
            bindings = <
&none            &kp GRAVE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON     &kp COMMA     &none                                                                 &none  &none  &none  &none  &none  &none  &none
&kp EXCLAMATION  &kp LEFT_BRACE  &kp SQT               &kp DOUBLE_QUOTES      &kp RIGHT_BRACE   &kp QUESTION  &none                                                                 &none  &none  &none  &none  &none  &none  &none
&kp HASH         &kp CARET       &kp EQUAL             &kp UNDERSCORE         &kp DOLLAR        &kp ASTERISK  &none          &kp NON_US_BACKSLASH  &kp PERIOD         &none  &none  &none  &none  &none  &none  &none  &none  &none
&kp TILDE        &kp LESS_THAN   &kp PIPE              &kp MINUS              &kp GREATER_THAN  &kp SLASH                                          &kp PERCENT        &none                &none  &none  &none  &none  &none  &none
&kp AT_SIGN      &kp AMPERSAND   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PLUS                        &kp BACKSPACE  &kp COLON             &kp SEMICOLON      &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };

        cursor {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                          &none           &none     &none   &none     &none      &none    &none
&none  &none  &none  &none  &none  &none  &none                                          &none           &none     &none   &none     &none      &none    &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none  &none          &kp LC(HOME)    &kp LEFT  &kp UP  &kp DOWN  &kp RIGHT  &kp END  &none
&none  &none  &none  &none  &none  &none                &none      &none                                 &none     &none   &none     &none      &none    &none
&none  &none  &none  &none  &none         &none  &none  &none      &none  &kp BACKSPACE  &kp LEFT_SHIFT            &none   &none     &none      &none    &none
            >;
        };

        num {
            bindings = <
&none  &none  &none  &none  &none  &none  &none                                        &none      &none         &none         &none   &none   &none     &none
&none  &none  &none  &none  &none  &none  &none                                        &none      &kp ASTERISK  &kp N7        &kp N8  &kp N9  &kp DOT   &none
&none  &none  &none  &none  &none  &none  &none  &none  &none      &none    &none      &none      &kp PLUS      &kp NUMBER_4  &kp N5  &kp N6  &kp N0    &none
&none  &none  &none  &none  &none  &none                &none      &none                          &kp MINUS     &kp N1        &kp N2  &kp N3  &kp FSLH  &none
&none  &none  &none  &none  &none         &none  &none  &none      &kp TAB  &kp ENTER  &kp SPACE                &none         &none   &none   &none     &none
            >;
        };

        type {
            bindings = <
&kp EQUAL       &kp N1    &kp N2     &kp N3     &kp N4   &kp N5     &kp PRINTSCREEN                                                                  &kp C_VOLUME_UP    &kp N6      &kp N7        &kp N8    &kp N9    &kp N0        &kp BSLH
&kp Q           &kp B     &kp Y      &kp O      &kp U    &kp SQT    &mt LS(LC(C)) LC(C)                                                              &kp C_VOLUME_DOWN  &kp SEMI    &kp L         &kp D     &kp W     &kp V         &kp Z
&kp LEFT_SHIFT  &kp C     &kp I      &kp E      &kp A    &kp COMMA  &mt LS(LC(V)) LC(V)  &bt BT_NXT  &out OUT_TOG      &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE         &kp PERIOD  &kp H         &kp T     &kp S     &kp N         &kp RIGHT_SHIFT
&caps_word      &kp G     &kp X      &kp J      &kp K    &kp MINUS                                   &kp HOME          &kp END                                          &kp FSLH    &kp R         &kp M     &kp F     &kp P         &to 0
&mo 1           &kp HOME  &kp PG_UP  &kp PG_DN  &kp END             &kp BACKSPACE        &kp DEL     &kp ESC           &kp TAB           &kp RET     &kp SPACE                      &kp LS(LPAR)  &kp LBKT  &kp RBKT  &kp LS(RPAR)  &mo 1
            >;
        };
    };
};
